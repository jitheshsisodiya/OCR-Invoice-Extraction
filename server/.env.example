# Server
HOST=127.0.0.1
PORT=7432
DEBUG=false

# Storage paths (defaults to ./data relative to server/)
UPLOAD_DIR=../data/uploads
THUMBNAIL_DIR=../data/thumbnails
EXPORT_DIR=../data/exports

# SQLite DB path
DATABASE_URL=sqlite:///./ocr_invoice.db

# AI features (optional — heuristic fallback used if not set)
ANTHROPIC_API_KEY=

# OCR settings
DEFAULT_OCR_ENGINE=tesseract
TESSERACT_CMD=tesseract
OCR_DPI=300
CROSS_VALIDATE_OCR=true
